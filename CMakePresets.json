{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "MHF_BUILD_TESTS": "ON" }
    },
    {
      "name": "linux-clang",
      "inherits": "base",
      "displayName": "Linux (Clang)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-clang-debug",
      "inherits": "linux-clang",
      "displayName": "Linux (Clang, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-clang",
      "displayName": "Linux (Clang, Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-asan",
      "inherits": "linux-clang",
      "displayName": "Linux (Clang, ASan + UBSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MHF_SANITIZE": "ON"
      }
    },
    {
      "name": "windows-clang",
      "inherits": "base",
      "displayName": "Windows (clang-cl)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "displayName": "Windows (MSVC)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ps4-orbis",
      "inherits": "base",
      "displayName": "PlayStation 4 (Orbis SDK)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/orbis.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "MHF_BUILD_PS4": "ON",
        "MHF_BUILD_LAUNCHER": "OFF",
        "MHF_WITH_SDL": "OFF",
        "MHF_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-clang", "configurePreset": "linux-clang", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "configuration": "Debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "configuration": "Release" },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan" },
    { "name": "windows-clang", "configurePreset": "windows-clang" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" }
  ],
  "testPresets": [
    { "name": "linux-clang", "configurePreset": "linux-clang", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-clang", "configurePreset": "windows-clang", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "output": { "outputOnFailure": true } }
  ]
}
