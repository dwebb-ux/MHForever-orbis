set(CMAKE_SYSTEM_NAME Orbis)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{SCE_ORBIS_SDK_DIR})
    message(FATAL_ERROR
        "MHF PS4 builds require SCE_ORBIS_SDK_DIR to point to an installed PlayStation 4 SDK.")
endif()

set(_mhf_orbis_sdk "$ENV{SCE_ORBIS_SDK_DIR}")
set(CMAKE_SYSROOT "${_mhf_orbis_sdk}" CACHE PATH "Orbis SDK root")
set(CMAKE_FIND_ROOT_PATH "${_mhf_orbis_sdk}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)

set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
